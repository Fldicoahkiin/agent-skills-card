{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-skills-card",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-06-17",
  // Static assets are wired to the client build by @cloudflare/vite-plugin; no directory needed.
  // run_worker_first sends /api/* to the Worker; other paths fall back to the SPA's index.html.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
